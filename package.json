{
  "name": "studentlife-os",
  "version": "1.0.0",
  "private": true,
  "description": "StudentLife OS - The Ultimate All-in-One Operating System for Students",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"cyan,magenta\" \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:all": "concurrently -n \"API,WEB\" -c \"cyan,magenta\" \"npm:dev:api\" \"npm:dev:web\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "keywords": [
    "studentlife-os",
    "study-planner",
    "ai-mentor",
    "exams",
    "career"
  ],
  "author": "StudentLife OS Team",
  "license": "MIT",
  "devDependencies": {
    "autoprefixer": "^10.5.5",
    "concurrently": "^10.0.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19"
  }
}
