# -------------------------------------------------------------
# StudentLife OS - Environment Configuration Template
# -------------------------------------------------------------

# Server Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL / SQLite for local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/studentlife_os?schema=public"
# For SQLite quick dev: "file:./dev.db"

# Cache & Message Queue
REDIS_URL="redis://localhost:6379"

# Authentication & Security
JWT_SECRET="studentlife_super_secret_jwt_access_token_key_change_in_prod"
JWT_REFRESH_SECRET="studentlife_super_secret_jwt_refresh_token_key_change_in_prod"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# OAuth Providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# AI Integration
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Email & Notifications (SMTP / Resend)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@studentlifeos.dev"
